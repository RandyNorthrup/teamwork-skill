{
  "$defs": {
    "line": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "vcs": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "oneOf": [
            { "$ref": "#/$defs/line" },
            { "type": "null" }
          ]
        },
        "head": {
          "oneOf": [
            { "$ref": "#/$defs/line" },
            { "type": "null" }
          ]
        },
        "remotes": {
          "items": { "$ref": "#/$defs/line" },
          "maxItems": 100,
          "type": "array"
        },
        "type": {
          "enum": ["git", "none"]
        },
        "worktree": {
          "items": { "$ref": "#/$defs/line" },
          "maxItems": 500,
          "type": "array"
        },
        "worktree_truncated": { "type": "boolean" }
      },
      "required": ["branch", "head", "remotes", "type", "worktree", "worktree_truncated"],
      "type": "object"
    }
  },
  "$id": "urn:teamwork:manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "payload_state": { "const": "ready" } }, "required": ["payload_state"] },
      "then": { "properties": { "sealed_at": { "$ref": "#/$defs/timestamp" } } },
      "else": { "properties": { "sealed_at": { "type": "null" } } }
    }
  ],
  "properties": {
    "created_at": { "$ref": "#/$defs/timestamp" },
    "discovery": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": { "maximum": 200, "minimum": 0, "type": "integer" },
        "candidate_limit": { "const": 200 },
        "truncated": { "type": "boolean" }
      },
      "required": ["candidate_count", "candidate_limit", "truncated"],
      "type": "object"
    },
    "payload_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "payload_state": { "enum": ["draft", "ready"] },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/line" },
        "harness": { "$ref": "#/$defs/line" },
        "hostname": { "$ref": "#/$defs/line" },
        "operating_system": { "$ref": "#/$defs/line" },
        "python": { "$ref": "#/$defs/line" },
        "safe_environment": {
          "additionalProperties": false,
          "properties": {
            "CI": { "$ref": "#/$defs/line" },
            "COMSPEC": { "$ref": "#/$defs/line" },
            "SHELL": { "$ref": "#/$defs/line" },
            "TERM_PROGRAM": { "$ref": "#/$defs/line" }
          },
          "type": "object"
        },
        "skill": { "const": "teamwork-handoff" },
        "skill_version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": ["agent", "harness", "hostname", "operating_system", "python", "safe_environment", "skill", "skill_version"],
      "type": "object"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "root_from_payload": { "const": ".." },
        "root_hint": { "$ref": "#/$defs/line" },
        "vcs": { "$ref": "#/$defs/vcs" }
      },
      "required": ["name", "root_from_payload", "root_hint", "vcs"],
      "type": "object"
    },
    "resume": {
      "additionalProperties": false,
      "properties": {
        "first_read": { "const": "STATUS.md" },
        "required_read_order": {
          "const": ["STATUS.md", "PROJECT.md", "NEXT_STEPS.md", "DECISIONS.md", "VALIDATION.md", "CONTEXT.md", "ENVIRONMENT.md", "WORKTREE.md", "SOURCES.md"]
        }
      },
      "required": ["first_read", "required_read_order"],
      "type": "object"
    },
    "revision": { "minimum": 0, "type": "integer" },
    "schema_name": { "const": "teamwork-payload" },
    "schema_version": { "const": "1.0.0" },
    "sealed_at": { "type": ["string", "null"] },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "warnings": {
      "items": { "$ref": "#/$defs/line" },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": ["created_at", "discovery", "payload_id", "payload_state", "producer", "project", "resume", "revision", "schema_name", "schema_version", "sealed_at", "updated_at", "warnings"],
  "title": "Teamwork manifest",
  "type": "object"
}
